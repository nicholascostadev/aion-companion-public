{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "semi": true,
  "tabWidth": 2,
  "printWidth": 100,
  "ignorePatterns": [
    "dist/**",
    "target/**",
    ".tools/**",
    "node_modules/**",
    "src-tauri/gen/**",
    "fixtures/**",
    "crates/companion-capture/data/**",
    "package-lock.json",
    "frontend/src/i18n/generated/**"
  ]
}
