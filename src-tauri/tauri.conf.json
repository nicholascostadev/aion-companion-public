{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aion Companion Prototype",
  "version": "0.7.37",
  "identifier": "org.aioncompanion.prototype",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Aion Companion · Combat workspace",
        "visible": false,
        "focus": false,
        "width": 1100,
        "height": 780,
        "minWidth": 760,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: map-art: http://map-art.localhost; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
