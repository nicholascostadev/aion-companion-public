      "content": "<div data-contents-type=\"text\"><div class=\"fr-image\" contenteditable=\"false\" data-contents-json=\"{&quot;src&quot;:&quot;https://fizz-download.playnccdn.com/lg/file/AION/download/1a0f7b48ab4-9fc6c80c-ab0e-4c8d-8884-b412f061d5f9&quot;,&quot;width&quot;:null,&quot;height&quot;:null}\" data-contents-type=\"image\"><div class=\"fe-image-inner\"><img src=\"https://fizz-download.playnccdn.com/lg/file/AION/download/1a0f7b48ab4-9fc6c80c-ab0e-4c8d-8884-b412f061d5f9\" alt=\"announcements_EN.jpg\" class=\"fe-image\"></div></div></div><div data-contents-type=\"text\"><span style=\"color: rgb(36, 36, 36);\"><br></span>Hello Daevas,</div><div data-contents-type=\"text\"><br class=\"ProseMirror-trailingBreak\"></div><div data-contents-type=\"text\">We will be performing maintenance on our platform services.&nbsp;</div><div data-contents-type=\"text\"><br class=\"ProseMirror-trailingBreak\"></div><div data-contents-type=\"text\"><u><strong>Details:</strong></u></div><div data-contents-type=\"text\"><br class=\"ProseMirror-trailingBreak\"></div><div class=\"tableWrapper\"><table class=\"_2CAsiFd9UHbUOqzd0e7ioe _1CtoyG6UPAlYp7PCGLXx8L\"><colgroup><col style=\"width: 230px;\"><col></colgroup><tbody><tr><th data-colwidth=\"230\" class=\"_3rLIt0O8F7iG6B2RmC3cYa\" style=\"padding: 4px 8px;\"><div data-contents-type=\"text\">When:</div></th><td style=\"padding: 4px 8px;\"><div data-contents-type=\"text\">October 13 starting 14:00 PDT / 23:00 CEST</div></td></tr><tr><th data-colwidth=\"230\" class=\"_3rLIt0O8F7iG6B2RmC3cYa\" style=\"padding: 4px 8px;\"><div data-contents-type=\"text\">​Duration:</div></th><td class=\"_3rLIt0O8F7iG6B2RmC3cYa\" style=\"padding: 4px 8px;\"><div data-contents-type=\"text\">30 minutes</div></td></tr><tr><th data-colwidth=\"230\" class=\"_3rLIt0O8F7iG6B2RmC3cYa\" style=\"padding: 4px 8px;\"><div data-contents-type=\"text\">Affected Services:</div></th><td class=\"_3rLIt0O8F7iG6B2RmC3cYa\" style=\"padding: 4px 8px;\"><div data-contents-type=\"text\" style=\"text-align: left;\">Account registration</div></td></tr></tbody></table></div><div data-contents-type=\"text\" style=\"text-align: left;\"><br class=\"ProseMirror-trailingBreak\"></div><div data-contents-type=\"text\" style=\"text-align: left;\"><br class=\"ProseMirror-trailingBreak\"></div><div data-contents-type=\"text\"><u><strong>Additional Notices:</strong></u></div><ul><li><div data-contents-type=\"text\">Once maintenance begins, you<span style=\"color: rgb(36, 36, 36);\">&nbsp;</span><span style=\"color: inherit;\">will not be able to register for an account until maintenance has concluded.&nbsp;</span></div></li></ul><ul><li><div data-contents-type=\"text\">The maintenance schedule and details are subject to change at any time. Any changes will be announced as an update via this notice.</div></li></ul><div data-contents-type=\"text\" style=\"text-align: left;\"><span style=\"color: rgb(36, 36, 36);\">&nbsp;</span></div><div data-contents-type=\"text\">Thanks for your patience and we apologize for any inconvenience caused.&nbsp;</div><div data-contents-type=\"text\"><br class=\"ProseMirror-trailingBreak\"></div><div data-contents-type=\"text\"><div class=\"fr-image\" contenteditable=\"false\" data-contents-json=\"{&quot;src&quot;:&quot;https://fizz-download.playnccdn.com/lg/file/AION/download/1a0f7b49ad6-e49a7dc9-efed-4d9d-be11-4a6cfa3df385&quot;,&quot;width&quot;:null,&quot;height&quot;:null}\" data-contents-type=\"image\"><div class=\"fe-image-inner\"><img src=\"https://fizz-download.playnccdn.com/lg/file/AION/download/1a0f7b49ad6-e49a7dc9-efed-4d9d-be11-4a6cfa3df385\" alt=\"Bottom banner.jpg\" class=\"fe-image\"></div></div></div><div data-contents-type=\"text\"><br class=\"ProseMirror-trailingBreak\"></div>"
